# Preferred: Vertex AI with Application Default Credentials.
# Authenticate locally with: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternative: Gemini Developer API / Google AI Studio.
# To use this mode, set GOOGLE_GENAI_USE_VERTEXAI=FALSE, leave the Vertex-only
# values unset, and provide an API key.
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-gemini-api-key

# RegOps application profile. Local mode uses no Google Cloud infrastructure.
REGOPS_ENV=local
REGOPS_FRONTEND_ORIGIN=http://localhost:3000

# Cloud profile (placeholders only; authenticate with ADC).
# REGOPS_ENV=cloud
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=global
# REGOPS_FIRESTORE_DATABASE=(default)
# REGOPS_PUBSUB_TOPIC=regops-lifecycle-events
# REGOPS_MODEL_ARMOR_LOCATION=us-central1
# REGOPS_MODEL_ARMOR_TEMPLATE=regops-control-plane-screening
# REGOPS_AGENT_REGISTRY_LOCATION=us-central1
# REGOPS_FRONTEND_ORIGIN=https://your-frontend-service.run.app
